javascript: (function () {
  if (window.wpmSolverBotExists) {
    alert("سكربت المساعد الذكي شغال بالفعل!");
    return;
  }
  window.wpmSolverBotExists = window.solverBotEnabled = true;

  // إنشاء واجهة تحكم متطورة ومريحة للعين
  const panel = document.createElement("div");
  Object.assign(panel.style, {
    position: "fixed",
    top: "10px",
    right: "10px",
    zIndex: "100000",
    backgroundColor: "#1a1a1a",
    color: "#fff",
    padding: "12px",
    borderRadius: "10px",
    boxShadow: "0 4px 20px rgba(0,0,0,0.6)",
    fontFamily: "Arial, sans-serif",
    fontSize: "12px",
    direction: "rtl",
    width: "190px",
    border: "1px solid #2ecc71"
  });

  panel.innerHTML = `
    <div style="font-weight:bold; text-align:center; margin-bottom:8px; color:#2ecc71; border-bottom:1px solid #333; padding-bottom:5px; font-size:13px;">⚡ الحلال التلقائي الذكي</div>
    <div style="margin-bottom:6px;">المساعد: <span id="solver-status" style="color:#2ecc71; font-weight:bold;">يعمل</span></div>
    <div style="margin-bottom:6px;">الطلب الذاتي: <span id="auto-req-status" style="color:#2ecc71; font-weight:bold;">نشط</span></div>
    <div style="margin-bottom:8px;">القسم النشط: <span id="current-mode-lbl" style="color:#f1c40f; font-weight:bold;">ويكي</span></div>
    <label style="display:block; margin-bottom:4px; color:#aaa;">تغيير القسم يدوياً:</label>
    <select id="mode-select" style="width:100%; background:#333; color:#fff; border:1px solid #555; padding:4px; borderRadius:4px; cursor:pointer; font-size:11px;">
      <option value="wiki">ويكي</option>
      <option value="jash">جش</option>
      <option value="shart">شرط</option>
      <option value="double">دبل</option>
      <option value="as">اص</option>
      <option value="tak">كرر</option>
      <option value="tash">جب</option>
      <option value="aks">عكس</option>
      <option value="raq">رق</option>
    </select>
    <button id="toggle-solver-btn" style="width:100%; margin-top:10px; background:#e74c3c; color:#fff; border:none; padding:6px; border-radius:4px; cursor:pointer; font-weight:bold;">تعطيل السكربت</button>
  `;
  document.body.appendChild(panel);

  const statusLbl = document.getElementById("solver-status");
  const autoReqLbl = document.getElementById("auto-req-status");
  const modeLbl = document.getElementById("current-mode-lbl");
  const modeSelect = document.getElementById("mode-select");
  const toggleBtn = document.getElementById("toggle-solver-btn");

  toggleBtn.addEventListener("click", () => {
    window.solverBotEnabled = !window.solverBotEnabled;
    if (window.solverBotEnabled) {
      statusLbl.textContent = "يعمل"; statusLbl.style.color = "#2ecc71";
      toggleBtn.textContent = "تعطيل السكربت"; toggleBtn.style.backgroundColor = "#e74c3c";
    } else {
      statusLbl.textContent = "متوقف"; statusLbl.style.color = "#e74c3c";
      toggleBtn.textContent = "تفعيل السكربت"; toggleBtn.style.backgroundColor = "#2ecc71";
      clearTimeout(sendTimeout);
    }
  });

  modeSelect.addEventListener("change", (e) => {
    currentMode = e.target.value;
    updateUI();
  });

  function updateUI() {
    const modeMapInverse = { wiki: "ويكي", jash: "جش", shart: "شرط", double: "دبل", as: "اص", tak: "كرر", tash: "جب", aks: "عكس", raq: "رق" };
    modeLbl.textContent = modeMapInverse[currentMode] || currentMode;
    modeSelect.value = currentMode;
    if (isAutoRequestBlocked) {
      autoReqLbl.textContent = "متوقف (لاعب آخر)"; autoReqLbl.style.color = "#e74c3c";
    } else {
      autoReqLbl.textContent = "نشط"; autoReqLbl.style.color = "#2ecc71";
    }
  }

  // متغيرات الأنظمة والتحكم التلقائي
  let currentMode = "wiki";
  let lastShartCondition = "";
  let tournamentModes = [];
  let tournamentIdx = 0;
  let inTournament = false;
  let isFirstRound = true;

  let isAutoRequestBlocked = false;
  let idleRequestTimeout = null;
  let sendTimeout = null;
  let iSentThisCommand = false;

  // إرسال الأوامر مع حماية التتبع الذاتي
  function sendCommandToChat(text) {
    iSentThisCommand = true;
    executeSendText(text);
    setTimeout(() => { iSentThisCommand = false; }, 1200);
  }

  // وظيفة إرسال نص فوري بالضغط على انتر
  function executeSendText(text) {
    const input = document.querySelector("#tbox"),
      btn = document.querySelector(".btn-primary") || document.querySelector("#sendbtn");
    if (!input) return;
    input.value = text;
    ["input", "change"].forEach((ev) => input.dispatchEvent(new Event(ev, { bubbles: true })));
    setTimeout(() => {
      if (typeof Tsend_TIGERHOST_UPLOAD === "function") Tsend_TIGERHOST_UPLOAD();
      else if (btn) btn.click();
      else input.dispatchEvent(new KeyboardEvent("keydown", { bubbles: true, cancelable: true, keyCode: 13, key: "Enter" }));
    }, 20);
  }

  // اختيار وإرسال قسم عشوائي
  function requestRandomSection() {
    if (inTournament || !window.solverBotEnabled || isAutoRequestBlocked) return;
    const sections = ["ويكي", "جش", "شرط", "دبل", "اص", "كرر", "جب", "عكس", "رق"];
    const randomSec = sections[Math.floor(Math.random() * sections.length)];
    sendCommandToChat(randomSec);
  }

  // إدارة مؤقت الخمول (3 دقائق) لإعادة التفعيل التلقائي
  function resetIdleRequestTimer() {
    clearTimeout(idleRequestTimeout);
    idleRequestTimeout = setTimeout(() => {
      isAutoRequestBlocked = false;
      updateUI();
      requestRandomSection();
    }, 180000); 
  }

  // تنفيذ الإرسال النهائي الموقوت بدون تدخل بشري
  function executeFinalSend() {
    const btn = document.querySelector(".btn-primary") || document.querySelector("#sendbtn");
    const input = document.querySelector("#tbox");
    if (!input) return;
    if (typeof Tsend_TIGERHOST_UPLOAD === "function") {
      Tsend_TIGERHOST_UPLOAD();
    } else if (btn) {
      btn.click();
    } else {
      input.dispatchEvent(new KeyboardEvent("keydown", { bubbles: true, cancelable: true, keyCode: 13, key: "Enter" }));
    }
  }

  // دوال حل وتفكيك الأقسام المزخرفة والمعقدة
  function undecorate(str) {
    return str
      .replace(/ٲ/g, "أ").replace(/ٳ/g, "إ").replace(/ٽ/g, "ث").replace(/ںُ/g, "ن")
      .replace(/ڕ/g, "ر").replace(/ۆ/g, "و").replace(/ࢥ/g, "ق").replace(/ݦ/g, "م")
      .replace(/ࢠ/g, "ب").replace(/ڄ/g, "ج").replace(/ڭ/g, "ك").replace(/ۂ/g, "ه")
      .replace(/ــ/g, "");
  }

  function solveTak(s) {
    return s.split(/\s+/).map((p) => {
      const m = p.match(/^([^\(]+)\((\d+)\)$/);
      return m ? Array(+m[2]).fill(m[1].trim()).join(" ") : p;
    }).join(" ").replace(/\s+/g, " ").trim();
  }

  function applyShartTransformation(wordsArr, condition) {
    let w = [...wordsArr]; if (w.length === 0) return "";
    const disassemble = (word) => word.split("").filter(Boolean).join(" ");
    switch (condition) {
      case "اول كلمتين دبل": if (w.length >= 2) w.splice(0, 2, w[0], w[0], w[1], w[1]); else if (w.length === 1) w.splice(0, 1, w[0], w[0]); break;
      case "اكتب المقاله عكس": w.reverse(); break;
      case "فكك الكلمه اللتي قبل الاخيره": if (w.length >= 2) w[w.length - 2] = disassemble(w[w.length - 2]); else w[0] = disassemble(w[0]); break;
      case "فكك الكلمه الثانيه": if (w.length >= 2) w[1] = disassemble(w[1]); else w[0] = disassemble(w[0]); break;
      case "بدل اخر كلمتين": if (w.length >= 2) { let tmp = w[w.length - 1]; w[w.length - 1] = w[w.length - 2]; w[w.length - 2] = tmp; } break;
      case "كرر أول كلمة وآخر كلمة": if (w.length >= 2) { w[0] = w[0] + " " + w[0]; w[w.length - 1] = w[w.length - 1] + " " + w[w.length - 1]; } else if (w.length === 1) { w[0] = w[0] + " " + w[0]; } break;
      case "فكك آخر كلمة": w[w.length - 1] = disassemble(w[w.length - 1]); break;
      case "فكك أول كلمة": w[0] = disassemble(w[0]); break;
    }
    return w.join(" ");
  }

  const chatBox = document.querySelector("#d2");
  if (!chatBox) {
    alert("لم يتم العثور على شاشه الدردشة!");
    return;
  }

  new MutationObserver((mutations) => {
    if (!window.solverBotEnabled) return;
    for (const m of mutations) {
      for (const node of m.addedNodes) {
        if (node.nodeType !== 1) continue;
        const msgNode = node.querySelector(".u-msg") || node.querySelector(".msg") || node;
        let msgText = msgNode.textContent || "";
        let cleanMsg = msgText.replace(/^[:\s\-،,]+/, "").trim();

        // رصد الأوامر المدخلة بالشات للتحول للقسم المناسب وفحص المنافسين
        const cmdMatch = cleanMsg.match(/^(ويكي|جش|شرط|دبل|اص|كرر|جب|عكس|رق)(\s+\d+)?$/);
        if (cmdMatch) {
          const matchedCmd = cmdMatch[1];
          const map = { "ويكي": "wiki", "جش": "jash", "شرط": "shart", "دبل": "double", "اص": "as", "كرر": "tak", "جب": "tash", "عكس": "aks", "رق": "raq" };
          currentMode = map[matchedCmd];
          inTournament = false;
          
          if (!iSentThisCommand) {
            isAutoRequestBlocked = true;
            resetIdleRequestTimer();
          }
          updateUI();
        }

        // رصد نظام الجولات المشتركة والتحكم بها
        if (cleanMsg.includes("الأقسام اللي بالجولة")) {
          const match = cleanMsg.match(/الأقسام اللي بالجولة\s*\(([^)]+)\)/);
          if (match) {
            const arabicModes = match[1].split(/\s+/).filter(Boolean);
            const map = { "ويكي": "wiki", "جش": "jash", "شرط": "shart", "دبل": "double", "اص": "as", "كرر": "tak", "جب": "tash", "عكس": "aks", "رق": "raq" };
            tournamentModes = arabicModes.map(m => map[m]).filter(Boolean);
            tournamentIdx = 0; inTournament = false;
          }
        }
        if (cleanMsg.includes("تم الجولة بدت") || cleanMsg.includes("تم الجوله بدت")) {
          inTournament = true; tournamentIdx = 0; isFirstRound = true;
          if (tournamentModes.length > 0) { currentMode = tournamentModes[0]; updateUI(); }
        }
        if (cleanMsg.includes("انتهت الجولة") || cleanMsg.includes("انهي الجولة") || cleanMsg.includes("انهي الجوله") || cleanMsg.includes("مبروك الفائز في الجولة")) {
          inTournament = false;
          if (!isAutoRequestBlocked) {
            setTimeout(requestRandomSection, Math.floor(Math.random() * 2000) + 2500);
          }
        }

        // مزامنة الـ ق4 لتغيير قسم الجولة تلقائياً
        if (cleanMsg === "ق4" && inTournament) {
          if (isFirstRound) { isFirstRound = false; } 
          else {
            if (tournamentModes.length > 0) {
              tournamentIdx = (tournamentIdx + 1) % tournamentModes.length;
              currentMode = tournamentModes[tournamentIdx];
              updateUI();
            }
          }
          continue;
        }

        // رصد شروط التعديل للشرط
        if (["اول كلمتين دبل", "اكتب المقاله عكس", "فكك الكلمه اللتي قبل الاخيره", "فكك الكلمه الثانيه", "بدل اخر كلمتين", "كرر أول كلمة وآخر كلمة", "فكك آخر كلمة", "فكك أول كلمة"].includes(cleanMsg)) {
          lastShartCondition = cleanMsg;
          continue;
        }

        // تتبع انتهاء المقال الفردي لطلب مقال جديد إذا كان الوضع التلقائي متاح
        if (!inTournament && !isAutoRequestBlocked && (cleanMsg.startsWith("كفو يا") || cleanMsg.startsWith("لـــ") || cleanMsg === "شطب")) {
          setTimeout(requestRandomSection, Math.floor(Math.random() * 1500) + 2000);
          continue;
        }

        // التعرف الفوري على نص السؤال
        let isQuestion = false;
        if (cleanMsg.includes(" ، ")) { isQuestion = true; } 
        else if (cleanMsg.includes("(") && cleanMsg.includes(")") && cleanMsg.match(/[^\s]+\(\d+\)/)) { isQuestion = true; currentMode = "tak"; updateUI(); } 
        else if (/[ٲٳڕࢥݦࢠٽںُۂۆڭڄ]/.test(cleanMsg)) { isQuestion = true; currentMode = "as"; updateUI(); }

        if (cleanMsg === "شطب" || cleanMsg.startsWith("لـــ") || cleanMsg.startsWith("كفو يا") || cleanMsg.startsWith("النشرة")) {
          isQuestion = false;
        }

        // معالجة الحل وحساب وقت التأخير بدقة الـ WPM
        if (isQuestion) {
          let answer = "";
          let words = cleanMsg.split(/\s*،\s*/).map(w => w.trim()).filter(Boolean);
          if (words.length === 1 && cleanMsg.includes(" ")) {
            words = cleanMsg.split(/\s+/).filter(Boolean);
          }

          if (currentMode === "wiki" || currentMode === "jash" || currentMode === "tash" || currentMode === "raq") { answer = words.join(" "); } 
          else if (currentMode === "double") { answer = words.map(w => `${w} ${w}`).join(" "); } 
          else if (currentMode === "aks") { answer = [...words].reverse().join(" "); } 
          else if (currentMode === "as") { answer = undecorate(cleanMsg).split(/\s+/).filter(Boolean).join(" "); } 
          else if (currentMode === "tak") { answer = solveTak(cleanMsg); } 
          else if (currentMode === "shart") { answer = applyShartTransformation(words, lastShartCondition); }

          if (answer) {
            // نسـخ فوري لداخل التكست بوكس للمعاينة البصرية
            const input = document.querySelector("#tbox");
            if (input) {
              input.value = answer;
              ["input", "change"].forEach((ev) => input.dispatchEvent(new Event(ev, { bubbles: true })));
            }

            // حساب مهلة التأخير الملي ثانية بناءً على نوع القسم والسرعة العشوائية المستهدفة
            const wc = words.length;
            let targetWpm = 130;
            let durSeconds = 2.0;

            if (currentMode === "tak") {
              targetWpm = Math.floor(Math.random() * (200 - 170 + 1)) + 170; // (170-200)
              durSeconds = (wc * 60) / (targetWpm - 20);
            } else if (currentMode === "double") {
              targetWpm = Math.floor(Math.random() * (200 - 170 + 1)) + 170; // (170-200)
              durSeconds = (wc * 120) / targetWpm;
            } else {
              targetWpm = Math.floor(Math.random() * (155 - 120 + 1)) + 120; // (120-155)
              durSeconds = (wc * 60) / (targetWpm - 25);
            }

            let delayMs = durSeconds * 1000;
            if (delayMs < 150 || isNaN(delayMs)) delayMs = 300; // حماية الحدود الدنيا

            // جدولة الكبس التلقائي بعد انتهاء مهلة السرعة المحسوبة
            clearTimeout(sendTimeout);
            sendTimeout = setTimeout(() => {
              if (window.solverBotEnabled) {
                executeFinalSend();
              }
            }, delayMs);
          }
        }
      }
    }
  }).observe(chatBox, { childList: true, subtree: true });

  // تشغيل أولي ذكي عند تشغيل الإشارة لأول مرة
  setTimeout(requestRandomSection, 1000);
  alert("تم تفعيل المساعد التلقائي الموقوت بنظام الحماية الذكي ⚡!");
})();
